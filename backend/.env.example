# AfyaNest server settings. Copy to .env, fill in, and NEVER commit .env.
# Load it with:  set -a; source .env; set +a

# dev = http://localhost cookies + /docs enabled. Use production on a real server (HTTPS).
AIRNEST_ENV=dev

# PostgreSQL (multi-tenant storage)
AIRNEST_DATABASE_URL=postgresql://afyanest:choose-a-strong-password@localhost:5432/afyanest

# 32-byte encryption key for farmers' phone numbers, e-mails and GPS. Generate ONCE and back it up:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AIRNEST_DATA_KEY=

# Africa's Talking incoming-SMS webhook secret (add ?token=... to the callback URL)
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
AIRNEST_SMS_TOKEN=

# SMS sending (leave empty to only log messages instead of sending)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Voice calls for danger alerts (1 = on) and the number calls come from
AIRNEST_VOICE=1
AT_VOICE_NUMBER=
# Phone number farmers can call for help (used in SMS replies)
AFYANEST_SUPPORT_PHONE=0700 000 000

# Optional: provisioning API for scripts (leave empty to disable)
AIRNEST_ADMIN_KEY=

# Staff accounts are created with tools/create_owner.py and the console. Keep 0.
AIRNEST_ALLOW_SIGNUP=0

# ---- the three models ---------------------------------------------------------
# Synthetic data for houses without a sensor box (1 = on). Real boxes switch a house to live.
AIRNEST_SYNTHETIC=1
# Outbreak watch: read news + official sources every N hours (1 = on)
AIRNEST_OSINT=1
AIRNEST_OSINT_HOURS=6
# Auto-text farmers only for OFFICIAL reports at or above this confidence (0-1)
AIRNEST_OSINT_AUTO_CONFIDENCE=0.8
# Extra RSS/Atom feeds to watch (https only, comma separated)
AIRNEST_OSINT_FEEDS=
